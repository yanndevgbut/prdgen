# ==============================================================================
# PRDGen.ai - Environment Variables Configuration
# ==============================================================================
# PETUNJUK:
# 1. Salin file ini menjadi .env.local: cp .env.example .env.local
# 2. Isi nilai kredensial dari dashboard Supabase dan 9router.
# 3. Kredensial rahasia (SUPABASE_SERVICE_ROLE_KEY & NINEROUTER_*) HANYA dibaca
#    di sisi server (Next.js Server Actions / API Routes) dan TIDAK PERNAH
#    diberikan prefix NEXT_PUBLIC_ agar aman dari bundle client/browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client & Auth (Public)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Project Settings -> API -> Project URL & Project API Keys (anon public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Service Role (Server-Only Secret - JANGAN GUNAKAN NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Project Settings -> API -> service_role secret
# Digunakan oleh Route Handlers & Server Actions untuk verifikasi role admin & audit
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. 9router AI Gateway (Server-Only Fallback)
# ------------------------------------------------------------------------------
# Kredensial fallback bawaan untuk 9router AI Gateway (OpenAI-compatible).
# Admin dapat mengubah Base URL dan API Key secara dinamis di halaman Admin Settings (/admin),
# dan sistem akan memprioritaskan konfigurasi dinamis yang tersimpan di database.
NINEROUTER_BASE_URL=https://api.9router.com/v1
NINEROUTER_API_KEY=your-9router-api-key-here

# ------------------------------------------------------------------------------
# 3a. OTP Encryption Key (Server-Only Secret - JANGAN GUNAKAN NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Kunci 32-byte (64 karakter hex) untuk enkripsi password sementara saat registrasi OTP.
# Generate dengan: openssl rand -hex 32
OTP_ENCRYPTION_KEY=your-64-char-hex-key-here

# ------------------------------------------------------------------------------
# 4. Resend.com Email Service (Server-Only Secret - JANGAN GUNAKAN NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Dapatkan API Key dari https://resend.com/api-keys
# Untuk testing lokal/development, gunakan onboarding@resend.dev
# Untuk production, gunakan domain yang telah diverifikasi di https://resend.com/domains
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=PRDGen <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 5. Pakasir Payment Gateway API v2 (Server-Only Secret - JANGAN GUNAKAN NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Dapatkan Slug, API Key, dan Webhook Secret dari https://app.pakasir.com
PAKASIR_SLUG=your-pakasir-project-slug
PAKASIR_API_KEY=your-pakasir-api-key-here
PAKASIR_WEBHOOK_SECRET=your-pakasir-webhook-secret-here
PAKASIR_BASE_URL=https://app.pakasir.com

# ------------------------------------------------------------------------------
# 6. Cloudflare Turnstile (Anti-Bot untuk Login, Daftar, dan Reset Password)
# ------------------------------------------------------------------------------
# Buat widget di https://dash.cloudflare.com -> Turnstile -> Add widget
#   - Widget mode: Managed
#   - Hostnames: prdgen.my.id (tambahkan localhost untuk testing lokal)
#
# NEXT_PUBLIC_* aman di browser. TURNSTILE_SECRET_KEY WAJIB server-only.
# Dikosongkan di development: verifikasi dilewati agar mudah diuji lokal
# (token dummy resmi Cloudflare: XXXX.DUMMY.TOKEN.XXXX juga selalu lolos).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. Upstash Redis (Rate Limiting Persisten untuk Serverless)
# ------------------------------------------------------------------------------
# Buat database di https://console.upstash.com
# Di production, isi kedua variabel ini agar rate limit bekerja lintas instance.
# Dikosongkan di development untuk fallback ke in-memory (tidak persisten).
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ------------------------------------------------------------------------------
# 8. App Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
